# Ansible managed — do not edit directly.
# Route {{ home_lan_subnet }} through the main table when it is connected, so
# Tailscale's accepted subnet route only applies away from home.
[Unit]
Description=Keep home LAN traffic local when on the home LAN
Before=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ip rule add to {{ home_lan_subnet }} lookup main suppress_prefixlength 0 priority 2500
ExecStop=/usr/sbin/ip rule del to {{ home_lan_subnet }} lookup main suppress_prefixlength 0 priority 2500

[Install]
WantedBy=multi-user.target
