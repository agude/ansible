# Ansible managed — do not edit directly.
[Unit]
Description=Keep home LAN traffic local when on the home LAN
Wants=NetworkManager.service
After=NetworkManager.service
Before=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tailscale-lan-direct
ExecStop=/usr/local/sbin/tailscale-lan-direct --clear

[Install]
WantedBy=multi-user.target
